/* VitroSim 样式表 */
QWidget {
    background-color: #f0f2f5;
    font-family: "Microsoft YaHei", Arial, sans-serif;
    font-size: 12px;
    color: #212121;
}

QMainWindow {
    background-color: #f0f2f5;
}

QPushButton {
    background-color: #1565c0;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #0d47a1;
}
QPushButton:disabled {
    background-color: #bdbdbd;
    color: #eeeeee;
}

QLabel#statusLabel {
    font-size: 13px;
    font-weight: 600;
}
QLabel#resultLabel {
    background-color: #e3f2fd;
    border-radius: 6px;
    padding: 8px 12px;
    color: #0d47a1;
    font-weight: 500;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
    color: #616161;
}

QChartView {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
}

QTableView {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}
QHeaderView::section {
    background-color: #f5f5f5;
    padding: 6px 12px;
    border-bottom: 2px solid #e0e0e0;
    font-weight: 600;
}